from collections import Counter

class Solution:
    def isNStraightHand(self, hand, groupSize):
        if len(hand) % groupSize != 0:
            return False

        count = Counter(hand)

        for num in sorted(count):
            while count[num] > 0:
        
                for i in range(num, num + groupSize):
                    if count[i] == 0:
                        return False
                    count[i] -= 1

        return True
