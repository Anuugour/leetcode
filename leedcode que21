class Solution:
    def kthSmallestPrimeFraction(self, arr, k):
        left, right = 0, 1

        while True:
            mid = (left + right) / 2
            count = 0
            p, q = 0, 1
            j = 1

            for i in range(len(arr)):
                while j < len(arr) and arr[i] > mid * arr[j]:
                    j += 1

                count += len(arr) - j

                if j < len(arr) and p * arr[j] < q * arr[i]:
                    p, q = arr[i], arr[j]

            if count == k:
                return [p, q]
            elif count < k:
                left = mid
            else:
                right = mid
