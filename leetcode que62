class Solution:
    def combinationSum3(self, k: int, n: int) -> List[List[int]]:

        ans = []

        def solve(num, total, path):
            if len(path) == k:

                if total == n:
                    ans.append(path[:])
                return

            for i in range(num, 10):
   
                if total + i > n:
                    break

                path.append(i)           
                solve(i + 1, total + i, path)   
                path.pop()             

        solve(1, 0, [])
        return ans
