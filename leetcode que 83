class Solution:
    MOD = 10**9 + 7

    def numRollsToTarget(self, n, k, target):
        dp = {}

        def solve(n, target):
            if n == 0:
                return 1 if target == 0 else 0

            if (n, target) in dp:
                return dp[(n, target)]

            ways = 0

            for i in range(1, k + 1):
                if target - i >= 0:
                    ways += solve(n - 1, target - i)

            dp[(n, target)] = ways % self.MOD
            return dp[(n, target)]

        return solve(n, target)
