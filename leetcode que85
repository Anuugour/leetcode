class Solution:
    def deleteAndEarn(self, nums: List[int]) -> int:
        count = Counter(nums)
        nums = sorted(count)

        prev = 0
        curr = 0

        for i, num in enumerate(nums):
            points = num * count[num]

            if i > 0 and num == nums[i - 1] + 1:
                new = max(curr, prev + points)
            else:
                new = curr + points

            prev = curr
            curr = new

        return curr
