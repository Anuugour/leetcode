from threading import Lock 
class ZeroEvenOdd: 
    def __init__(self, n): 
        self.n = n 
        self.cur = 1 
        self.z = Lock() # Semaphore(1) 
        self.e = Lock() # Semaphore(1) 
        self.o = Lock() # Semaphore(1) 
        self.e.acquire() 
        self.o.acquire() 
 
    def zero(self, printNumber: 'Callable[[int], None]') -> None: 
        for i in range(self.n): 
            with self.z: 
                printNumber(0) 
                if self.cur % 2: 
                    self.o.release() 
                else: 
                    self.e.release()     
            self.z.acquire()         
 
    def even(self, printNumber: 'Callable[[int], None]') -> None: 
        for i in range(self.n // 2): 
            with self.e: 
                printNumber(self.cur) 
                self.cur += 1 
                self.z.release() 
            self.e.acquire()     
 
    def odd(self, printNumber: 'Callable[[int], None]') -> None: 
        for i in range((self.n + 1) // 2): 
            with self.o: 
                printNumber(self.cur) 
                self.cur += 1 
                self.z.release() 
            self.o.acquire()          make it easy
