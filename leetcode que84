class Solution:
    def findSolution(self, customfunction, z):
        ans = []

        for x in range(1, 1001):
            left, right = 1, 1000

            while left <= right:
                y = (left + right) // 2
                value = customfunction.f(x, y)

                if value == z:
                    ans.append([x, y])
                    break
                elif value < z:
                    left = y + 1
                else:
                    right = y - 1

        return ans
