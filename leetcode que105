class Solution:
    def resultArray(self, nums, k):
        ans = [0] * k
        curr = [0] * k

        for num in nums:
            rem = num % k
            new = [0] * k

            new[rem] += 1

            for r in range(k):
                if curr[r] > 0:
                    new[(r * rem) % k] += curr[r]

            for r in range(k):
                ans[r] += new[r]

            curr = new

        return ans
