class Solution:
    def reverseOnlyLetters(self, s: str) -> str:
        letters = []

        # Store all letters
        for ch in s:
            if ch.isalpha():
                letters.append(ch)

        ans = ""

        # Build answer
        for ch in s:
            if ch.isalpha():
                ans += letters.pop()   # Take last letter
            else:
                ans += ch

        return ans
