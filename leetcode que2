from functools import lru_cache
from itertools import groupby

class Solution:
    def removeBoxes(self, boxes):

        boxes = tuple((x, len(list(y))) for x, y in groupby(boxes))

        @lru_cache(None)
        def dfs(b):

            if not b:
                return 0

            c, k = b[0]
            ans = k * k + dfs(b[1:])

            for i in range(1, len(b)):

                if b[i][0] == c:

                    ans = max(
                        ans,
                        dfs(b[1:i]) +
                        dfs(((c, k + b[i][1]),) + b[i+1:])
                    )

            return ans

        return dfs(boxes)
