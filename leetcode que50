from collections import deque

class Solution:
    def isEvenOddTree(self, root):
        q = deque([root])
        level = 0

        while q:
            size = len(q)

            # Starting value for comparison
            if level % 2 == 0:
                prev = float("-inf")   # increasing
            else:
                prev = float("inf")    # decreasing

            for _ in range(size):
                node = q.popleft()

                if level % 2 == 0:
                    # Even level -> odd values & increasing
                    if node.val % 2 == 0 or node.val <= prev:
                        return False
                else:
                    # Odd level -> even values & decreasing
                    if node.val % 2 == 1 or node.val >= prev:
                        return False

                prev = node.val

                if node.left:
                    q.append(node.left)
                if node.right:
                    q.append(node.right)

            level += 1

        return True
