class Solution:
    def duplicateZeros(self, arr: List[int]) -> None:
        N = len(arr)
        ans = [0] * N                  
        i = 0
        j = 0
        while j < N:                   
            ans[j] = arr[i]            
            j += 1
            if arr[i] == 0 and j < N: 
                ans[j] = 0
                j += 1
            arr[i] = ans[i]             
            i += 1
        for k in range(i, N):          
            arr[k] = ans[k]
