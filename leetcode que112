class Solution:
    def hasValidPath(self, grid: list[list[str]]) -> bool:

        m = len(grid)
        n = len(grid[0])

        if grid[0][0] == ')':
            return False

        if (m + n - 1) % 2 != 0:
            return False

        dp = {(0, 0, 1)}

        for i in range(m):
            for j in range(n):

                current = []

                for x, y, balance in dp:
                    if x == i and y == j:
                        current.append(balance)

                for balance in current:

                    # Down
                    if i + 1 < m:
                        if grid[i + 1][j] == '(':
                            new_balance = balance + 1
                        else:
                            new_balance = balance - 1

                        if new_balance >= 0:
                            dp.add((i + 1, j, new_balance))

                    # Right
                    if j + 1 < n:
                        if grid[i][j + 1] == '(':
                            new_balance = balance + 1
                        else:
                            new_balance = balance - 1

                        if new_balance >= 0:
                            dp.add((i, j + 1, new_balance))

        return (m - 1, n - 1, 0) in dp
