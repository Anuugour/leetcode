from itertools import combinations

class CombinationIterator:

    def __init__(self, characters: str, combinationLength: int):
        # Store all possible combinations
        self.comb = [''.join(c) for c in combinations(characters, combinationLength)]
        self.index = 0

    def next(self) -> str:
        ans = self.comb[self.index]
        self.index += 1
        return ans

    def hasNext(self) -> bool:
        return self.index < len(self.comb)
