from bisect import bisect_left

class Solution:
    def preimageSizeFZF(self, k: int) -> int:

        def countZero(n):
            count = 0

            while n > 0:
                n //= 5
                count += n

            return count

        def find(k):
            left = 0
            right = 5 * k + 5

            while left < right:
                mid = (left + right) // 2

                if countZero(mid) < k:
                    left = mid + 1
                else:
                    right = mid

            return left

        return find(k + 1) - find(k)
