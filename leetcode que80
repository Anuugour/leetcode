import re
from math import gcd

class Solution:
    def fractionAddition(self, expression: str) -> str:
        nums = list(map(int, re.findall(r'[+-]?\d+', expression)))

        num = 0
        den = 1

        for i in range(0, len(nums), 2):
            a = nums[i]
            b = nums[i + 1]

            num = num * b + a * den
            den = den * b

        g = gcd(num, den)

        return str(num // g) + "/" + str(den // g)
