class Solution:
    def strangePrinter(self, s):
        n = len(s)
        dp = [[-1] * n for _ in range(n)]

        def solve(i, j):
            if i > j:
                return 0

            if dp[i][j] != -1:
                return dp[i][j]

            ans = 1 + solve(i + 1, j)

            for k in range(i + 1, j + 1):
                if s[i] == s[k]:
                    ans = min(ans, solve(i, k - 1) + solve(k + 1, j))

            dp[i][j] = ans
            return ans

        return solve(0, n - 1)
