import math

class Solution:
    def simplifiedFractions(self, n: int) -> List[str]:
        ans = []

        for den in range(2, n + 1):      # denominator
            for num in range(1, den):   # numerator
                if math.gcd(num, den) == 1:
                    ans.append(str(num) + "/" + str(den))

        return ans
